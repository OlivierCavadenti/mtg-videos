{
  "name": "mtg-videos",
  "private": true,
  "type": "module",
  "description": "An archive of Magic: The Gathering creator videos and podcasts, by set, format and period.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run data && vite",
    "build": "npm run data && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test scripts/test/*.test.ts",
    "data": "tsx scripts/build-data.ts",
    "sets": "tsx scripts/sets.ts",
    "cards": "tsx scripts/cards.ts",
    "sync": "tsx scripts/sync.ts",
    "backfill": "tsx scripts/backfill.ts",
    "reclassify": "tsx scripts/reclassify.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "fast-xml-parser": "^5.12.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
